<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Home screen grid picker (Home settings). The Wallpaper & style app that used to
         offer this is not shipped (AxThemePicker overrides it), so the launcher offers
         its own grids directly. Values are the grid names in device_profiles.xml. -->
    <string name="pref_home_grid_title">Home screen grid</string>
    <string name="pref_home_grid_summary">%s. Fewer columns can move icons to other pages.</string>
    <string-array name="pref_home_grid_entries" translatable="false">
        <item>4 × 4</item>
        <item>4 × 5</item>
        <item>4 × 6</item>
        <item>5 × 5</item>
        <item>5 × 6</item>
        <item>5 × 7</item>
    </string-array>
    <string-array name="pref_home_grid_values" translatable="false">
        <item>4_by_4</item>
        <item>4_by_5</item>
        <item>4_by_6</item>
        <item>5_by_5</item>
        <item>5_by_6</item>
        <item>5_by_7</item>
    </string-array>
</resources>
